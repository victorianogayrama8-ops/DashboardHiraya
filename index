<script>
const PACKAGES=[
{name:"Day Tour Cottage Pass",price:1200,unit:"up to 6 guests",kind:"Day pass",desc:"8:00 AM–5:00 PM · pool access, bamboo picnic cabana, grilling station, parking and shower rooms.",icon:"🌴",units:6},
{name:"Traditional Native Kubo",price:2500,unit:"per night · 4 pax",kind:"Overnight",desc:"Check-in 2:00 PM · native wooden nipa hut, balcony, night swimming until 9:00 PM, campfire access and morning island coffee.",icon:"🛖",units:8},
{name:"Bayview Grand Gazebo",price:4500,unit:"up to 15 pax",kind:"Day or overnight",desc:"Covered pavilion for gatherings, seating, food-prep counter, pool pathway and bonfire wood bundle.",icon:"🏡",units:2}
];
const today=new Date();const iso=d=>{let x=new Date(d);return `${x.getFullYear()}-${String(x.getMonth()+1).padStart(2,'0')}-${String(x.getDate()).padStart(2,'0')}`};
const plus=(d,n)=>{let x=new Date(d);x.setDate(x.getDate()+n);return iso(x)};
const sampleBookings=[
{id:1001,name:"Maria Santos",email:"maria.santos@example.com",phone:"+63 917 000 0101",type:PACKAGES[1].name,in:plus(today,2),out:plus(today,3),guests:4,amount:2500,status:"Confirmed"},
{id:1002,name:"Jerome Cruz",email:"jerome.cruz@example.com",phone:"+63 917 000 0102",type:PACKAGES[0].name,in:plus(today,1),out:plus(today,1),guests:5,amount:1200,status:"Pending"},
{id:1003,name:"Karen Reyes",email:"karen.reyes@example.com",phone:"+63 917 000 0103",type:PACKAGES[2].name,in:plus(today,4),out:plus(today,5),guests:12,amount:4500,status:"Confirmed"},
{id:1004,name:"Paolo Garcia",email:"paolo.garcia@example.com",phone:"+63 917 000 0104",type:PACKAGES[1].name,in:plus(today,-2),out:plus(today,-1),guests:3,amount:2500,status:"Checked in"},
{id:1005,name:"Angela Dela Cruz",email:"angela.dc@example.com",phone:"+63 917 000 0105",type:PACKAGES[0].name,in:plus(today,6),out:plus(today,6),guests:6,amount:1200,status:"Pending"},
{id:1006,name:"Noah Villanueva",email:"noah.v@example.com",phone:"+63 917 000 0106",type:PACKAGES[1].name,in:plus(today,8),out:plus(today,9),guests:2,amount:2500,status:"Cancelled"},
{id:1007,name:"Liza Mendoza",email:"liza.m@example.com",phone:"+63 917 000 0107",type:PACKAGES[2].name,in:plus(today,10),out:plus(today,11),guests:10,amount:4500,status:"Confirmed"}
];
let bookings=[];try{const stored=localStorage.getItem("hirayaDemoBookings");bookings=stored?JSON.parse(stored):sampleBookings}catch(e){bookings=sampleBookings}
let inventory={};try{inventory=JSON.parse(localStorage.getItem("hirayaDemoInventory")||"{}")}catch(e){}
let calDate=new Date(today.getFullYear(),today.getMonth(),1);
const peso=n=>"₱"+Number(n||0).toLocaleString("en-PH",{maximumFractionDigits:0});
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const fmt=d=>d?new Date(d+"T12:00:00").toLocaleDateString("en-PH",{month:"short",day:"numeric",year:"numeric"}):"—";
const initials=n=>String(n||"?").split(/\s+/).slice(0,2).map(a=>a[0]||"").join("").toUpperCase();
const save=()=>{try{localStorage.setItem("hirayaDemoBookings",JSON.stringify(bookings));localStorage.setItem("hirayaDemoInventory",JSON.stringify(inventory))}catch(e){}};
const statusClass=s=>({"Confirmed":"confirmed","Pending":"pending","Checked in":"checkedin","Cancelled":"cancelled"}[s]||"pending");
function showToast(msg){const t=document.getElementById("toast");t.textContent=msg;t.classList.add("show");setTimeout(()=>t.classList.remove("show"),2600)}
function showView(v){document.querySelectorAll(".view").forEach(x=>x.classList.toggle("active",x.id==="view-"+v));document.querySelectorAll(".nav button").forEach(x=>x.classList.toggle("active",x.dataset.view===v));document.getElementById("crumb").textContent=({overview:"Overview",bookings:"Bookings",rooms:"Rooms & cottages",guests:"Guest management",calendar:"Reservations calendar",reviews:"Guest reviews",reports:"Reports & analytics",messages:"Messages & texting"})[v]||v;document.getElementById("sidebar").classList.remove("open");renderAll();if(v==="overview")drawChart();window.scrollTo(0,0)}
document.querySelectorAll(".nav button").forEach(b=>b.addEventListener("click",()=>showView(b.dataset.view)));
document.getElementById("mobilemenu").onclick=()=>document.getElementById("sidebar").classList.toggle("open");
function renderAll(){renderOverview();renderBookings();renderRooms();renderGuests();renderCalendar();renderReports();renderMessages()}
function activeBookings(){return bookings.filter(b=>b.status!=="Cancelled")}
function renderOverview(){
const month=today.getMonth(),year=today.getFullYear();document.getElementById("statBookings").textContent=bookings.filter(b=>{let d=new Date(b.in+"T12:00:00");return d.getMonth()===month&&d.getFullYear()===year}).length;
document.getElementById("statRevenue").textContent=peso(activeBookings().reduce((s,b)=>s+Number(b.amount||0),0));
document.getElementById("recentBookings").innerHTML=bookings.slice().sort((a,b)=>b.id-a.id).slice(0,5).map(b=>`<tr><td><div class="guest"><div class="guestpic">${esc(initials(b.name))}</div>${esc(b.name)}</div></td><td>${esc(b.type)}</td><td>${fmt(b.in)}</td><td>${peso(b.amount)}</td><td><span class="pill ${statusClass(b.status)}">${esc(b.status)}</span></td></tr>`).join("")||'<tr><td colspan="5" class="empty">No bookings yet.</td></tr>';
document.getElementById("roomMix").innerHTML=PACKAGES.map(p=>{let count=bookings.filter(b=>b.type===p.name&&b.status!=="Cancelled").length;let pct=bookings.length?count/bookings.length*100:0;return `<div class="roomrow"><div class="roomico">${p.icon}</div><div><strong>${p.name}</strong><small>${count} sample active booking(s)</small><div class="progress"><i style="width:${pct}%"></i></div></div><div class="roomcount">${Math.round(pct)}%<small>mix</small></div></div>`}).join("");
const acts=bookings.slice().sort((a,b)=>b.id-a.id).slice(0,4);document.getElementById("activity").innerHTML=acts.map((b,i)=>`<div class="activityitem"><div class="activityicon">${i%2?"✓":"▣"}</div><div><strong>${esc(b.name)} · ${esc(b.status)}</strong><small>${esc(b.type)} · ${fmt(b.in)}</small></div></div>`).join("")||'<div class="empty">No recent activity.</div>';
}
function renderBookings(){const search=(document.getElementById("bookingSearch")?.value||"").toLowerCase(),filter=document.getElementById("statusFilter")?.value||"";
document.getElementById("bookTotal").textContent=bookings.length;document.getElementById("bookConfirmed").textContent=bookings.filter(b=>b.status==="Confirmed"||b.status==="Checked in").length;document.getElementById("bookPending").textContent=bookings.filter(b=>b.status==="Pending").length;document.getElementById("bookCancelled").textContent=bookings.filter(b=>b.status==="Cancelled").length;
let rows=bookings.filter(b=>(!filter||b.status===filter)&&[b.name,b.type,b.email,b.phone,b.status].join(" ").toLowerCase().includes(search)).sort((a,b)=>b.id-a.id);
document.getElementById("bookingRows").innerHTML=rows.map(b=>`<tr><td><div class="guest"><div class="guestpic">${esc(initials(b.name))}</div>${esc(b.name)}</div><div class="muted">${esc(b.email||"No email")}</div></td><td>${esc(b.type)}</td><td>${fmt(b.in)}</td><td>${fmt(b.out)}</td><td>${b.guests}</td><td>${peso(b.amount)}</td><td><span class="pill ${statusClass(b.status)}">${esc(b.status)}</span></td><td><button class="btn small" onclick="editBooking(${b.id})">Edit</button> <button class="btn small danger" onclick="deleteBooking(${b.id})">Delete</button></td></tr>`).join("")||'<tr><td colspan="8" class="empty">No matching bookings.</td></tr>';
}
document.getElementById("bookingSearch").addEventListener("input",renderBookings);document.getElementById("statusFilter").addEventListener("change",renderBookings);
function renderRooms(){document.getElementById("roomCards").innerHTML=PACKAGES.map((p,i)=>`<div class="panel"><div class="panelhead"><div style="display:flex;gap:12px;align-items:center"><div class="roomico" style="width:48px;height:48px;font-size:23px">${p.icon}</div><div><h3>${p.name}</h3><p>${p.kind}</p></div></div><span class="pill confirmed">Published package</span></div><div style="font-size:25px;font-weight:800;color:#20344a">${peso(p.price)} <span style="font-size:11px;font-weight:500;color:#718096">${p.unit}</span></div><p style="font-size:12px;color:#647589;min-height:52px">${p.desc}</p><div class="footnote">Demo bookings: ${bookings.filter(b=>b.type===p.name&&b.status!=="Cancelled").length} active</div></div>`).join("");
document.getElementById("inventoryRows").innerHTML=PACKAGES.map(p=>{let units=inventory[p.name]?.units??p.units;let reserved=bookings.filter(b=>b.type===p.name&&b.status!=="Cancelled"&&b.in<=iso(today)&&b.out>=iso(today)).length;let avail=Math.max(0,units-reserved);return `<tr><td><strong>${p.name}</strong></td><td>${units}</td><td>${reserved}</td><td>${avail}</td><td><div class="progress" style="width:110px"><i style="width:${units?Math.min(100,reserved/units*100):0}%"></i></div></td><td><input aria-label="Sample units" type="number" min="0" max="999" value="${units}" style="width:70px;padding:7px;border:1px solid #dce5eb;border-radius:7px" onchange="updateInventory('${p.name.replace(/'/g,"\\'")}',this.value)"> <span class="muted">units</span></td></tr>`}).join("")}
function updateInventory(name,val){inventory[name]={units:Math.max(0,Number(val)||0)};save();renderRooms();showToast("Demo inventory updated")}
function uniqueGuests(){const map=new Map();bookings.forEach(b=>{let key=(b.email||b.name).toLowerCase();if(!map.has(key))map.set(key,{name:b.name,email:b.email||"",phone:b.phone||"",bookings:[],spend:0});let g=map.get(key);g.bookings.push(b);if(b.status!=="Cancelled")g.spend+=Number(b.amount||0)});return [...map.values()]}
function renderGuests(){let gs=uniqueGuests(),q=(document.getElementById("guestSearch")?.value||"").toLowerCase();document.getElementById("guestCount").textContent=gs.length;document.getElementById("guestActive").textContent=bookings.filter(b=>b.status==="Confirmed"||b.status==="Checked in").length;document.getElementById("guestNights").textContent=bookings.filter(b=>b.status!=="Cancelled").reduce((s,b)=>s+Math.max(1,Math.round((new Date(b.out)-new Date(b.in))/86400000)),0);
document.getElementById("guestRows").innerHTML=gs.filter(g=>[g.name,g.email,g.phone].join(" ").toLowerCase().includes(q)).map(g=>{let last=g.bookings.slice().sort((a,b)=>b.in.localeCompare(a.in))[0];return `<tr><td><div class="guest"><div class="guestpic">${esc(initials(g.name))}</div>${esc(g.name)}</div></td><td>${esc(g.email||"—")}</td><td>${esc(g.phone||"—")}</td><td>${g.bookings.length}</td><td>${fmt(last?.in)}</td><td>${peso(g.spend)}</td></tr>`}).join("")||'<tr><td colspan="6" class="empty">No matching guests.</td></tr>'}
document.getElementById("guestSearch").addEventListener("input",renderGuests);
function renderCalendar(){const y=calDate.getFullYear(),m=calDate.getMonth();document.getElementById("monthLabel").textContent=calDate.toLocaleDateString("en-PH",{month:"long",year:"numeric"});let first=new Date(y,m,1),start=new Date(y,m,1-first.getDay()),days=["Sun","Mon","Tue","Wed","Thu","Fri","Sat"];let out=days.map(d=>`<div class="calhead">${d}</div>`).join("");for(let i=0;i<42;i++){let d=new Date(start);d.setDate(start.getDate()+i);let key=iso(d),events=bookings.filter(b=>b.in===key&&b.status!=="Cancelled");out+=`<div class="calday ${d.toDateString()===today.toDateString()?"today":""}" style="${d.getMonth()!==m?"opacity:.4":""}"><div class="date">${d.getDate()} ${d.toDateString()===today.toDateString()?"· Today":""}</div>${events.map(b=>`<span class="event" title="${esc(b.name)}">${esc(b.name)} · in</span>`).join("")}</div>`}document.getElementById("calendar").innerHTML=out}
function changeMonth(n){calDate=new Date(calDate.getFullYear(),calDate.getMonth()+n,1);renderCalendar()}function goToday(){calDate=new Date(today.getFullYear(),today.getMonth(),1);renderCalendar()}
function renderReports(){let active=activeBookings(),total=active.reduce((s,b)=>s+Number(b.amount||0),0);document.getElementById("reportRevenue").textContent=peso(total);document.getElementById("reportAverage").textContent=peso(active.length?total/active.length:0);document.getElementById("reportConfirm").textContent=(bookings.length?Math.round(bookings.filter(b=>b.status==="Confirmed"||b.status==="Checked in").length/bookings.length*100):0)+"%";
let sts=["Confirmed","Pending","Checked in","Cancelled"];document.getElementById("statusReport").innerHTML=sts.map(s=>{let n=bookings.filter(b=>b.status===s).length;return `<div class="roomrow"><div class="roomico">${({"Confirmed":"✓","Pending":"◷","Checked in":"♙","Cancelled":"×"})[s]}</div><div><strong>${s}</strong><small>${n} record(s)</small><div class="progress"><i style="width:${bookings.length?n/bookings.length*100:0}%;background:${s==="Cancelled"?"#d85c64":s==="Pending"?"#f2b84b":"#1c8c88"}"></i></div></div><div class="roomcount">${bookings.length?Math.round(n/bookings.length*100):0}%</div></div>`}).join("");
document.getElementById("priceReport").innerHTML=PACKAGES.map(p=>`<div class="roomrow"><div class="roomico">${p.icon}</div><div><strong>${p.name}</strong><small>${p.unit}</small></div><div class="roomcount">${peso(p.price)}</div></div>`).join("")}
const defaultTemplates=[
{id:"confirm",title:"Booking confirmation",channel:"SMS",body:"Hi {{guest_name}}, your booking at Hiraya Bay Resort is confirmed! Accommodation: {{accommodation}}. Check-in: {{check_in}}. For questions, call +63 917 127 5265. Thank you!"},
{id:"reminder",title:"Arrival reminder",channel:"SMS",body:"Hello {{guest_name}}! This is a reminder of your Hiraya Bay Resort booking for {{check_in}} ({{accommodation}}). Please contact the resort if your arrival details change."},
{id:"emailconfirm",title:"Email booking confirmation",channel:"Email",body:"Dear {{guest_name}},\n\nThank you for choosing Hiraya Bay Resort. Your sample reservation details are below:\nAccommodation: {{accommodation}}\nCheck-in: {{check_in}}\n\nPlease contact the resort if you have any questions. We look forward to welcoming you!\n\nHiraya Bay Resort"}
];
let messages=[];try{messages=JSON.parse(localStorage.getItem("hirayaDemoMessages")||"[]")}catch(e){messages=[]}
let selectedConversation="",messageChannel="SMS";
function persistMessages(){try{localStorage.setItem("hirayaDemoMessages",JSON.stringify(messages))}catch(e){}}
function convKey(m){return (m.email||m.phone||m.guest||"Guest").toLowerCase()}
function renderMessages(){let q=(document.getElementById("messageSearch")?.value||"").toLowerCase();let convs=new Map();messages.forEach(m=>{let k=convKey(m);if(!convs.has(k))convs.set(k,[]);convs.get(k).push(m)});let list=[...convs.entries()].filter(([k,arr])=>(arr[0].guest+" "+(arr[0].phone||"")+" "+(arr[0].email||"")+" "+arr.map(x=>x.body).join(" ")).toLowerCase().includes(q)).sort((a,b)=>(b[1].at||"").localeCompare(a[1].at||""));document.getElementById("messageCount").textContent=convs.size;document.getElementById("smsDraftCount").textContent=messages.filter(m=>m.channel==="SMS").length;document.getElementById("emailDraftCount").textContent=messages.filter(m=>m.channel==="Email").length;document.getElementById("inboxList").innerHTML=list.map(([k,arr])=>{let m=arr[arr.length-1];return `<button class="inbox-item ${k===selectedConversation?"selected":""}" onclick="selectConversation('${k.replace(/'/g,"\\'")}')"><strong>${esc(m.guest||"Guest")}</strong><small>${esc(m.channel)} · ${esc(m.phone||m.email||"No contact")}</small><p>${esc(m.body)}</p></button>`}).join("")||'<div class="empty">No messages yet. Compose a message or use a template.</div>';renderThread();renderTemplates()}
function selectConversation(k){selectedConversation=k;let m=messages.find(x=>convKey(x)===k);if(m)messageChannel=m.channel||"SMS";renderMessages();setChannel(messageChannel)}
function setChannel(ch){messageChannel=ch;document.getElementById("smsTab").classList.toggle("active",ch==="SMS");document.getElementById("emailTab").classList.toggle("active",ch==="Email");document.getElementById("sendModeNote").textContent=ch==="SMS"?"Demo only · no SMS sent":"Demo only · no email sent";renderThread()}
function renderThread(){let arr=messages.filter(m=>convKey(m)===selectedConversation);let last=arr[arr.length-1];document.getElementById("threadTitle").textContent=last?(last.guest||"Guest")+(last.channel==="Email"?" · Email":" · SMS"):"Compose a message";document.getElementById("threadSubtitle").textContent=last?(last.phone||last.email||"No contact details")+" · local demo history":"No live provider connection";document.getElementById("chatThread").innerHTML=arr.length?arr.map(m=>`<div class="bubble ${m.direction==="in"?"in":"out"}">${esc(m.body)}<small>${esc(m.channel)} · ${new Date(m.at).toLocaleString()} · ${esc(m.state||"Demo saved")}</small></div>`).join(""):'<div class="empty">No messages in this conversation yet.</div>';document.getElementById("chatThread").scrollTop=99999}
function renderTemplates(){document.getElementById("messageTemplates").innerHTML=defaultTemplates.map(t=>`<div class="template-card"><h4>${esc(t.title)} <span class="pill ${t.channel==="SMS"?"checkedin":"confirmed"}">${t.channel}</span></h4><p>${esc(t.body)}</p><button class="btn small" onclick="useTemplate('${t.id}')">Use template</button></div>`).join("")}
function useTemplate(id){let t=defaultTemplates.find(x=>x.id===id);if(!t)return;messageChannel=t.channel;selectedConversation="";document.getElementById("replyText").value=t.body;setChannel(t.channel);document.getElementById("threadTitle").textContent="New message · "+t.title;document.getElementById("threadSubtitle").textContent="Replace template placeholders and select a guest before saving.";document.getElementById("replyText").focus()}
function newMessage(){selectedConversation="";document.getElementById("replyText").value="";setChannel("SMS");document.getElementById("threadTitle").textContent="New message";document.getElementById("threadSubtitle").textContent="Enter recipient details in the prompt when saving the demo message.";document.getElementById("replyText").focus();document.getElementById("view-messages").scrollIntoView({behavior:"smooth",block:"start"})}
document.getElementById("messageSearch").addEventListener("input",renderMessages);
document.getElementById("replyForm").addEventListener("submit",e=>{e.preventDefault();let body=document.getElementById("replyText").value.trim();if(!body)return;let prior=messages.find(m=>convKey(m)===selectedConversation);let guest=prior?.guest||prompt("Guest name for this local demo message:","");if(!guest){showToast("Message not saved; guest name is required");return}let phone=prior?.phone||"",email=prior?.email||"";if(!prior){if(messageChannel==="SMS")phone=prompt("Guest mobile number (demo only; no SMS will be sent):","")||"";else email=prompt("Guest email address (demo only; no email will be sent):","")||""}let m={id:Date.now(),guest,phone,email,channel:messageChannel,body,direction:"out",at:new Date().toISOString(),state:"Demo saved · not sent"};messages.push(m);selectedConversation=convKey(m);persistMessages();document.getElementById("replyText").value="";renderMessages();showToast("Saved locally only — not sent")});
// Real SMS integration placeholder: intentionally disabled until a secure backend is deployed.
async function sendRealSmsThroughBackend(payload){throw new Error("SMS backend is not configured. Implement authenticated POST /api/messages/sms on your server before enabling delivery.")}

function openBooking(){document.getElementById("bookingForm").reset();document.getElementById("bookingId").value="";document.getElementById("modalTitle").textContent="Add sample booking";document.getElementById("fIn").value=plus(today,1);document.getElementById("fOut").value=plus(today,2);document.getElementById("fAmount").value=2500;document.getElementById("bookingModal").classList.add("open")}
function closeModal(){document.getElementById("bookingModal").classList.remove("open")}
function editBooking(id){let b=bookings.find(x=>x.id===id);if(!b)return;document.getElementById("bookingId").value=id;document.getElementById("modalTitle").textContent="Edit sample booking";document.getElementById("fName").value=b.name;document.getElementById("fEmail").value=b.email||"";document.getElementById("fPhone").value=b.phone||"";document.getElementById("fType").value=b.type;document.getElementById("fIn").value=b.in;document.getElementById("fOut").value=b.out;document.getElementById("fGuests").value=b.guests;document.getElementById("fAmount").value=b.amount;document.getElementById("fStatus").value=b.status;document.getElementById("bookingModal").classList.add("open")}
function deleteBooking(id){if(!confirm("Delete this sample booking?"))return;bookings=bookings.filter(b=>b.id!==id);save();renderAll();drawChart();showToast("Sample booking deleted")}
document.getElementById("bookingForm").addEventListener("submit",e=>{e.preventDefault();let id=Number(document.getElementById("bookingId").value),b={id:id||Date.now(),name:document.getElementById("fName").value.trim(),email:document.getElementById("fEmail").value.trim(),phone:document.getElementById("fPhone").value.trim(),type:document.getElementById("fType").value,in:document.getElementById("fIn").value,out:document.getElementById("fOut").value,guests:Number(document.getElementById("fGuests").value),amount:Number(document.getElementById("fAmount").value),status:document.getElementById("fStatus").value};if(b.out<b.in){showToast("Check-out cannot be before check-in");return}if(id)bookings=bookings.map(x=>x.id===id?b:x);else bookings.push(b);save();closeModal();renderAll();drawChart();showToast(id?"Sample booking updated":"Sample booking added")});
function csvEscape(v){return '"'+String(v??"").replace(/"/g,'""')+'"'}function downloadCSV(name,rows){let blob=new Blob([rows.map(r=>r.map(csvEscape).join(",")).join("\r\n")],{type:"text/csv;charset=utf-8;"}),url=URL.createObjectURL(blob),a=document.createElement("a");a.href=url;a.download=name;a.click();URL.revokeObjectURL(url);showToast("CSV export prepared")}
function exportBookings(){downloadCSV("hiraya-demo-bookings.csv",[["ID","Guest","Email","Phone","Accommodation","Check-in","Check-out","Guests","Amount PHP","Status"],...bookings.map(b=>[b.id,b.name,b.email,b.phone,b.type,b.in,b.out,b.guests,b.amount,b.status])])}
function exportGuests(){downloadCSV("hiraya-demo-guests.csv",[["Guest","Email","Phone","Bookings","Sample spend PHP"],...uniqueGuests().map(g=>[g.name,g.email,g.phone,g.bookings.length,g.spend])])}
function drawChart(){let canvas=document.getElementById("revenueChart");if(!canvas||!canvas.offsetParent)return;let rect=canvas.getBoundingClientRect(),dpr=window.devicePixelRatio||1;canvas.width=rect.width*dpr;canvas.height=rect.height*dpr;let c=canvas.getContext("2d");c.scale(dpr,dpr);let w=rect.width,h=rect.height,pad={l:42,r:12,t:10,b:30},cw=w-pad.l-pad.r,ch=h-pad.t-pad.b;let vals=Array(6).fill(0);bookings.filter(b=>b.status!=="Cancelled").forEach(b=>{let d=new Date(b.in+"T12:00:00"),idx=(d.getMonth()-today.getMonth()+12)%12;if(idx<6)vals[5-idx]+=Number(b.amount||0)});let max=Math.max(5000,...vals)*1.15; c.clearRect(0,0,w,h);c.font="10px system-ui";c.strokeStyle="#e9eef2";c.fillStyle="#7b8998";for(let i=0;i<4;i++){let y=pad.t+ch*i/3;c.beginPath();c.moveTo(pad.l,y);c.lineTo(w-pad.r,y);c.stroke();c.fillText("₱"+Math.round(max*(1-i/3)/1000)+"k",2,y+4)}let labels=[];for(let i=5;i>=0;i--){let d=new Date(today.getFullYear(),today.getMonth()-i,1);labels.push(d.toLocaleDateString("en",{month:"short"}))}let bw=Math.min(26,cw/10);vals.forEach((v,i)=>{let x=pad.l+(i+.5)*cw/6-bw/2,barH=v/max*ch,y=pad.t+ch-barH;c.fillStyle="#1c8c88";c.beginPath();c.roundRect?c.roundRect(x,y,bw,barH,4):c.rect(x,y,bw,barH);c.fill();c.fillStyle="#7b8998";c.textAlign="center";c.fillText(labels[i],x+bw/2,h-8)});c.textAlign="left"}
window.addEventListener("resize",drawChart);document.getElementById("bookingModal").addEventListener("click",e=>{if(e.target.id==="bookingModal")closeModal()});
renderAll();drawChart();
</script>
